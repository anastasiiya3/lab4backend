// routes/products.js
const express = require('express');
const router = express.Router();
const Product = require('../models/Product');
const deleteLogger = require('../middleware/deleteLogger');

// Застосовуємо middleware для всього роутера
router.use(deleteLogger);

// GET всіх продуктів
router.get('/', async (req, res) => {
  try {
    const products = await Product.find();
    res.json(products);
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

// GET одного продукту за ID
router.get('/:id', async (req, res) => {
  try {
    const product = await Product.findById(req.params.id);
    if (!product) return res.status(404).json({ error: 'Not found' });
    res.json(product);
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

// POST - створити новий продукт
router.post('/', async (req, res) => {
  try {
    const product = new Product(req.body);
    await product.save();
    res.status(201).json(product);
  } catch (err) {
    res.status(400).json({ error: err.message });
  }
});

// DELETE - видалити продукт і залогірувати через middleware
router.delete('/:id', async (req, res) => {
  try {
    const product = await Product.findByIdAndDelete(req.params.id);
    if (!product) return res.status(404).json({ error: 'Not found' });
    
    // Передаємо видалений документ у відповідь, щоб middleware міг його зберегти
    res.json({ message: 'Deleted successfully', deletedDocument: product });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

module.exports = router;
